# Chess Arena — environment template (NEVER put real secrets in git).
#
# The app runs fully offline without these. To enable hybrid/online mode,
# pass them at run time instead (recommended):
#
#   flutter run --dart-define=SUPABASE_URL=https://xyzcompany.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi...
#
# NOTE: the sbp_... token in acesstoken.txt is a Supabase MANAGEMENT token
# (for api.supabase.com). The app needs the PROJECT url + anon key, found in
# Supabase Dashboard → Project Settings → API. See docs/SUPABASE_SETUP.md.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Future monetization (google_mobile_ads). Leave false for now.
ADS_ENABLED=false
